# Everything Mailchilla needs before the panel can come up. That is all this
# file is for: the rest — the mailbox, the service name, the code word, the
# limits, the inbounds, the languages, Gotify, the app buttons — is configured
# in the panel itself and lives in settings.json.

# --- Access to the 3x-ui panel ---
# Either a login and a password, or an API token.
XUI_URL=http://your-xui-panel-ip:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_secure_password
XUI_API_TOKEN=

# --- Signing in to the Mailchilla web panel ---
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=change_me_strong_password
# The secret the session cookie is signed with — a long random string,
# `openssl rand -hex 32` for instance. An empty value means a new secret on
# every start, and so a sign-out from the panel after every restart.
ADMIN_PANEL_SECRET=
# The panel listens on localhost alone. To reach it from outside use an SSH
# tunnel or a reverse proxy rather than 0.0.0.0.
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=8080

# --- Logs ---
# How many recent records to keep in memory for the /logs page.
LOG_BUFFER_SIZE=2000
# A rotating file so history survives a restart (empty writes nothing to disk).
LOG_FILE=logs/bot.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUPS=3
